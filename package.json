{
  "name": "gemini-media-aggregator",
  "version": "1.0.0",
  "description": "Gemini Media Aggregator — creative studio, media suite, finance terminal and office tools in one SPA.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "lint": "tsc --noEmit",
    "test:maggi": "tsx scripts/maggi-selftest.ts && tsx scripts/maggi-integration.ts",
    "test:maggi:unit": "tsx scripts/maggi-selftest.ts",
    "test:maggi:e2e": "tsx scripts/maggi-integration.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@heroicons/react": "^2.2.0",
    "@types/express": "^4.17.21",
    "clsx": "^2.1.1",
    "d3": "7.9.0",
    "esbuild": "^0.28.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.12.1",
    "file-saver": "^2.0.5",
    "firebase": "^12.14.0",
    "html-entities": "^2.6.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "mammoth": "1.6.0",
    "motion": "^12.38.0",
    "pdf-parse": "^2.4.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-image-crop": "^11.1.2",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "4.6.2",
    "recharts": "^3.9.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.22.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.14.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^31.0.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.7"
  }
}
